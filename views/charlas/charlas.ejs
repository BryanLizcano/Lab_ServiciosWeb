<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Charlas del Auditorio - <%= nombre %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/header', { nombre: nombre }) %>

    <main>
        <h2 style="text-align: center; margin-top: 20px;">Charlas MongoDB Atlas</h2>
        <section class="listado">
            <% if (charlas && charlas.length > 0) { %>
                <% charlas.forEach(function(charla) { %>
                    <article class="tarjeta-auto" style="padding: 20px;">
                        <h2 style="color: #2c3e50;"><%= charla.titulo %></h2>
                        <p><strong>Fecha y Hora:</strong> <%= charla.fecha %> a las <%= charla.hora %></p>
                        <p style="font-style: italic;"><%= charla.descripcion %></p>
                        <hr style="margin: 10px 0;">
                        <p><strong>Expositor:</strong> <%= charla.expositor.nombre %> (<%= charla.expositor.especialidad %>)</p>
                    </article>
                <% }); %>
            <% } else { %>
                <p>No hay charlas programadas.</p>
            <% } %>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>