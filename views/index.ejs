<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Catalogo de Autos - <%= nombre %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('partials/header', { nombre: nombre }) %>

    <main>
        <section class="listado">
            <% autos.forEach(function(auto) { %>
                <article class="tarjeta-auto">
                    <h2><%= auto.marca %> <%= auto.modelo %></h2>
                    <p>Categoría: <%= auto.categoria %></p>
                    <a href="/auto/<%= auto.id %>">Ver detalle</a>
                </article>
            <% }); %>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>